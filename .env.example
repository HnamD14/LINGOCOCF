# ══════════════════════════════════════════════════════════════════
# LingoCóc — Environment Variables Template
# Sao chép file này thành .env rồi điền giá trị thật:
#   cp .env.example .env
# ⚠️  KHÔNG bao giờ commit file .env lên git!
# ══════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────
DB_NAME=lingococ
DB_USER=postgres
DB_PASS=your_strong_db_password_here

# ── JWT ───────────────────────────────────────────────────────────
# Tạo secret ngẫu nhiên 64+ ký tự, ví dụ:
#   openssl rand -base64 64
JWT_SECRET=replace-with-a-random-64-char-secret
JWT_EXPIRATION=86400000

# ── Gmail (App Password) ──────────────────────────────────────────
# Bật 2FA trên Gmail → Tạo App Password tại:
#   https://myaccount.google.com/apppasswords
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx

# ── SePay ─────────────────────────────────────────────────────────
SEPAY_WEBHOOK_SECRET=your_sepay_webhook_secret

# ── Anthropic Claude AI ───────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── App URLs ──────────────────────────────────────────────────────
APP_FRONTEND_URL=https://your-domain.com
CORS_ORIGINS=https://your-domain.com
